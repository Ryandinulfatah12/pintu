# Wajib. Minimal 32 karakter. Generate: openssl rand -hex 32
# JANGAN diganti setelah ada data — password koneksi yang tersimpan jadi tidak bisa dibuka.
SECRET_KEY=

# Akun login ke Pintu
ADMIN_USER=admin
ADMIN_PASSWORD=

# true kalau diakses lewat HTTPS (Cloudflare Tunnel / Caddy)
COOKIE_SECURE=true

# Lama sesi login (jam)
SESSION_HOURS=12

# QUIET | ERRORS | NORMAL | VERBOSE | DEBUG
LOG_LEVEL=ERRORS
